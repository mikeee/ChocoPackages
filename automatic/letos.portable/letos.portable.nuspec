<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
	<metadata>
		<id>letos.portable</id>
		<version>4.0.4</version>
		<packageSourceUrl>https://github.com/mikeee/ChocoPackages/tree/master/automatic/letos.portable</packageSourceUrl>
		<owners>mikeee</owners>
		<title>Letos (Portable)</title>
		<authors>pawelsalawa</authors>
		<projectUrl>https://letos.org</projectUrl>
		<iconUrl>https://cdn.jsdelivr.net/gh/mikeee/ChocoPackages/icons/letos.portable.png</iconUrl>
		<requireLicenseAcceptance>false</requireLicenseAcceptance>
		<projectSourceUrl>https://github.com/pawelsalawa/letos</projectSourceUrl>
		<tags>letos sqlite sqlitestudio portable database manager</tags>
		<summary>Create, edit, browse SQLite databases.</summary>
		<description>Create, edit, browse SQLite databases.

**NOTE**: This is an automatically updated package. If you find it is out of date by more than a week, please contact the maintainer(s) and let them know the package is no longer updating correctly.
</description>
	</metadata>
	<files>
		<file src="tools\**" target="tools" />
	</files>
</package>
